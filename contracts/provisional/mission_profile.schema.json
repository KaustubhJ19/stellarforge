{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_profile.schema.json",
  "title": "MissionProfile",
  "x-status": "PROVISIONAL test double: owned by Spec 5",
  "type": "object",
  "required": [
    "id",
    "name",
    "crew",
    "equipment",
    "delay_one_way_s"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "stub": {
      "type": "boolean"
    },
    "crew": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delay_one_way_s": {
      "type": "number",
      "minimum": 0
    },
    "delay_label": {
      "type": "string"
    }
  }
}