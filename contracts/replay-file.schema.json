{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stellarforge:contracts:replay-file",
  "title": "ReplayFile",
  "description": "A replay: events ordered by t (Spec 1 Contracts table). Ordering is checked by the shared validator.",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Contract version. Spec 1: include a schema_version field."
    },
    "crew": {},
    "profile": {},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "description": "Mission clock seconds"
          },
          "type": {},
          "payload": {}
        },
        "required": [
          "t",
          "type",
          "payload"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "crew",
    "profile",
    "events"
  ]
}
