{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stellarforge:contracts:ground-report",
  "title": "GroundReport",
  "description": "A report sent to ground, with optional reply (Spec 1 Contracts table).",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Contract version. Spec 1: include a schema_version field."
    },
    "id": {},
    "crew": {},
    "summary": {},
    "history": {
      "type": "array"
    },
    "timeline": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "sent_t": {
      "type": "number",
      "description": "Mission clock seconds"
    },
    "reply_t": {
      "type": "number",
      "description": "Mission clock seconds (optional)"
    },
    "reply": {
      "description": "optional"
    },
    "copilot": {
      "description": "optional, added by Spec 3 (add-only): the hash-chained copilot record of this emergency. events are the copilot_* events as stored (each carries prev, the SHA-256 of the one before); chain.head is the SHA-256 of the newest, so a receiver can re-check the copy.",
      "type": "object",
      "required": ["chain", "events"],
      "properties": {
        "chain": {
          "type": "object",
          "required": ["ok", "length", "head"],
          "properties": {
            "ok": {"type": "boolean"},
            "reason": {"type": "string"},
            "length": {"type": "integer", "minimum": 0},
            "head": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "type", "emergency", "prev"],
            "properties": {
              "t": {"type": "number"},
              "type": {"type": "string", "pattern": "^copilot_"},
              "emergency": {"type": "string"},
              "prev": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "versions": {"type": "object", "description": "schema, model and content versions of the build that advised"},
        "timings": {"type": "object", "description": "Mission clock seconds: assessed_t, chosen_t, choice_after_s, investigator_elapsed_s"}
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "crew",
    "summary",
    "history",
    "timeline",
    "actions",
    "sent_t"
  ]
}
