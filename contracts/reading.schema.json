{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stellarforge:contracts:reading",
  "title": "Reading",
  "description": "A single measurement (Spec 1 Contracts table).",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Contract version. Spec 1: include a schema_version field."
    },
    "crew": {},
    "indicator": {},
    "value": {},
    "unit": {},
    "t": {
      "type": "number",
      "description": "Mission clock seconds"
    },
    "source": {
      "enum": [
        "sensor",
        "camera",
        "mic",
        "manual",
        "lab",
        "sim"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "state": {
      "enum": [
        "released",
        "quarantined",
        "event"
      ]
    }
  },
  "required": [
    "schema_version",
    "crew",
    "indicator",
    "value",
    "unit",
    "t",
    "source",
    "confidence",
    "state"
  ]
}
