{
  "note": "Router table (docs/spec-intent-routing.md). First matching row wins. A row picks a protocol; it never contains clinical steps. Routing rules are team values, not clinical guidance.",
  "pending_protocols": ["cabin-air", "fainting", "low-blood-sugar", "severe-bleeding", "sepsis", "overheating", "decompression-sickness", "seizure", "head-injury"],
  "rows": [
    {
      "id": "auto-trigger",
      "when": {"trigger_kind": "auto"},
      "protocol": "microgravity-cpr",
      "reason": "The automatic arrest rule fired, so the questions are skipped."
    },
    {
      "id": "unresponsive-not-breathing",
      "when": {"responsive": "no", "breathing": ["none", "abnormal"]},
      "protocol": "microgravity-cpr",
      "reason": "Rescuer reports the patient does not respond and is not breathing normally."
    },
    {
      "id": "arrest-rhythm",
      "when": {"live_arrest": true},
      "protocol": "microgravity-cpr",
      "reason": "The live heart rhythm is an arrest rhythm."
    },
    {
      "id": "chest-pain-responsive",
      "when": {"main_problem": "chest_pain", "responsive": "yes"},
      "protocol": "chest-pain",
      "reason": "Rescuer reports chest pain in a patient who responds (crew-reported symptom)."
    },
    {
      "id": "collapse-responsive",
      "when": {"main_problem": "collapse", "responsive": "yes", "breathing": "normal"},
      "protocol": "fainting",
      "reason": "Rescuer reports a collapse in a patient who now responds and breathes normally."
    },
    {
      "id": "cabin-alert-reported",
      "when": {"main_problem": "cabin_alert"},
      "protocol": "cabin-air",
      "reason": "Rescuer reports a cabin air problem."
    },
    {
      "id": "cabin-alert-live",
      "when": {"live_cabin_alert": true},
      "protocol": "cabin-air",
      "reason": "A cabin air alert is active."
    },
    {
      "id": "low-blood-sugar-reported",
      "when": {"main_problem": "low_blood_sugar"},
      "protocol": "low-blood-sugar",
      "reason": "Rescuer reports low blood sugar."
    },
    {
      "id": "bleeding-reported",
      "when": {"main_problem": "bleeding"},
      "protocol": "severe-bleeding",
      "reason": "Rescuer reports severe bleeding."
    },
    {
      "id": "head-injury-reported",
      "when": {"main_problem": "head_injury"},
      "protocol": "head-injury",
      "reason": "Rescuer reports a head injury."
    },
    {
      "id": "infection-reported",
      "when": {"main_problem": "infection"},
      "protocol": "sepsis",
      "reason": "Rescuer reports a severe infection."
    },
    {
      "id": "overheating-reported",
      "when": {"main_problem": "overheating"},
      "protocol": "overheating",
      "reason": "Rescuer reports overheating or fever."
    },
    {
      "id": "after-eva-reported",
      "when": {"main_problem": "after_eva"},
      "protocol": "decompression-sickness",
      "reason": "Rescuer reports a problem after a spacewalk (EVA)."
    },
    {
      "id": "seizure-reported",
      "when": {"main_problem": "seizure"},
      "protocol": "seizure",
      "reason": "Rescuer reports a seizure."
    }
  ],
  "fallback": {
    "id": "no-match",
    "reason": "No cited protocol matches what was reported. Ground should advise."
  }
}
